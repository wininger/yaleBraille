PKG_CFLAGS = -I./liblouis \
             -I$(R_INCLUDE_DIR) \
             -DPACKAGE_NAME=\"liblouis\" \
             -DPACKAGE_STRING=\"liblouis\ 3.38.0\" \
             -DPACKAGE_VERSION=\"3.38.0\" \
             -w

SOURCES = liblouis/commonTranslationFunctions.c \
          liblouis/compileTranslationTable.c \
          liblouis/lou_translateString.c \
          liblouis/lou_backTranslateString.c \
          liblouis/logging.c \
          liblouis/metadata.c \
          liblouis/pattern.c \
          liblouis/utils.c \
          wrapper.c

OBJECTS = $(SOURCES:.c=.o)
